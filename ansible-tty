#!/usr/bin/env python3

"""
This script facilitates SSH connections using Ansible inventory. It ensures the environment is set up correctly and then
establishes an SSH connection to a specified host from the inventory. It requires Python 3.5 or greater and depends on
the 'prettytable' module for displaying tables in the terminal.

License: GNU General Public License v3 or later (GPLv3+)
"""

import json
import subprocess
import shutil
import argparse
import sys
import os
import re
import logging
from prettytable import PrettyTable
from typing import Any, Dict, List, Optional

try:
    import boto3
    from botocore.exceptions import ClientError, NoCredentialsError
    BOTO3_AVAILABLE = True
except ImportError:
    BOTO3_AVAILABLE = False

# Configure logging
logging.basicConfig(
    level=logging.INFO,
    format='%(levelname)s: %(message)s'
)
logger = logging.getLogger(__name__)

# List of required executables
REQUIRED_EXECUTABLES = ["ssh", "ansible-inventory"]

# SSH variables that might be optionally included in the Ansible host vars
OPTIONAL_SSH_VARS = [
    {"key": "ansible_ssh_private_key_file", "flag": "-i"},
    {"key": "ansible_ssh_common_args", "flag": None},
    {"key": "ansible_ssh_extra_args", "flag": None},
    {"key": "ansible_port", "flag": "-p"},
]



def check_python_version() -> None:
    """Ensure that the script is running on Python 3.5 or greater."""
    if sys.version_info[:2] < (3, 5):
        logger.error("You need Python 3.5 or greater")
        sys.exit(1)


def check_executables(check_aws: bool = False) -> None:
    """Ensure that all required executables are available in the system path."""
    for executable in REQUIRED_EXECUTABLES:
        if shutil.which(executable) is None:
            logger.error(f"Can't find {executable} executable")
            logger.error("You must have installed Ansible >=2.4 and an SSH client")
            sys.exit(1)

    # Check for AWS CLI if SSM connection is needed
    if check_aws and shutil.which("aws") is None:
        logger.error("Can't find 'aws' executable")
        logger.error("You must have installed AWS CLI and SSM plugin for SSM connections")
        logger.error("Install guide: https://docs.aws.amazon.com/systems-manager/latest/userguide/session-manager-working-with-install-plugin.html")
        sys.exit(1)


def parse_args() -> argparse.Namespace:
    """Parse command-line arguments."""
    parser = argparse.ArgumentParser(
        description="Initialize an SSH interactive terminal using Ansible inventories."
    )

    parser.add_argument(
        "-i", "--inventory", help="Specify an Ansible inventory file.", type=str
    )
    parser.add_argument("-k", "--key", help="Specify a private SSH key file.", type=str)
    parser.add_argument("-c", "--color", help="Enable color mode for different environments", action='store_true')
    parser.add_argument("-pb", "--production_background", help="If color enabled, background color (production)", type=str)
    parser.add_argument("-pf", "--production_foreground", help="If color enabled, foreground color (production)", type=str)
    parser.add_argument("-ej", "--enable_jump", help="Use a jump host for SSH targets that are not directly reachable", action='store_true')
    parser.add_argument("-g", "--generate-ssh-config", help="Generate an ssh_config file with all hosts from the inventory.", action='store_true')
    parser.add_argument(
        "hostname", help="Connect to a specific hostname.", type=str, nargs="?"
    )

    return parser.parse_args()

def extract_keyword_from_group(group_name: str) -> str:
    """
    Extract specific keywords ('production', 'staging', 'prod', 'stg') from a group name.
    If none of these keywords are found, return the original group name.
    """
    # Define a regular expression pattern to match the keywords
    pattern = r"(production|prod|staging|stg|development|develop|dev|beta)"
    match = re.search(pattern, group_name, re.IGNORECASE)

    if match:
        return match.group(0)  # Return the matched keyword
    return group_name  # Return the original name if no keyword is found

def shorten_group_name(group_name: str) -> str:
    """
    Return a shortened version of the group name based on predefined mappings.
    """
    return extract_keyword_from_group(group_name)




def get_inventory(inventory_path: Optional[str]) -> Dict[str, Any]:
    """Fetch the Ansible inventory in JSON format."""
    # Set the default inventory path if not provided
    inventory_path = inventory_path or os.environ.get("ANSIBLE_INVENTORY", "/etc/ansible/ansible_inventory")
    ansible_cmd = ["ansible-inventory", "--list"]
    if inventory_path and os.path.exists(inventory_path):
        ansible_cmd.extend(["-i", inventory_path])

    logger.info("Getting inventory... please wait")
    proc = subprocess.run(ansible_cmd, stdout=subprocess.PIPE, timeout=20, check=True)
    return json.loads(proc.stdout.decode("utf-8"))

def get_top_level_groups(inventory: Dict[str, Any]) -> List[str]:
    """
    Get the list of top-level groups which are direct children of the 'all' group.
    """
    # Directly access the children of the 'all' group
    if 'all' in inventory and 'children' in inventory['all']:
        sorted_groups = sorted(inventory['all']['children'])
        # remove the 'ungrouped' group if present
        if 'ungrouped' in sorted_groups:
            sorted_groups.remove('ungrouped')
        return sorted_groups
    else:
        return []

def choose_group(inventory: Dict[str, Any], current_level: Optional[str] = None) -> str:
    """
    Allow the user to choose a group from the inventory, supporting navigation through group tiers.
    """
    if current_level:
        # If a current level is provided, list its children
        groups = inventory[current_level].get("children", {})
    else:
        # If no current level is provided, list the top-level groups
        groups = get_top_level_groups(inventory)

    sorted_groups = sorted(groups)
    current_list = sorted_groups

    while True:
        print("\033[H\033[J", end="")
        print(f"Choose a group{' (filtered)' if len(current_list) < len(sorted_groups) else ''}:")
        table = PrettyTable()
        table.field_names = ["Index", "Group Name"]
        table.align = "l"
        table.border = True

        for index, group in enumerate(current_list):
            table.add_row([index, shorten_group_name(group)])

        print(table)

        prompt = "Choose a valid group index, filter with '/keyword'"
        if len(current_list) == 1:
            prompt += " or press Enter to select the only option"
        prompt += " or press CTRL+C to exit: "

        user_input = input(prompt).strip()

        if not user_input and len(current_list) == 1:
            selected_group = current_list[0]
            if "children" in inventory.get(selected_group, {}):
                return choose_group(inventory, selected_group)
            else:
                return selected_group

        if user_input == '/':
            current_list = sorted_groups
            continue

        if user_input.startswith('/'):
            filter_str = user_input[1:].lower()
            new_list = [g for g in sorted_groups if filter_str in g.lower() or filter_str in shorten_group_name(g).lower()]
            if not new_list:
                print(f"\033[91mNo groups found matching '{filter_str}'. Keeping current list.\033[0m")
            else:
                current_list = new_list
            continue

        try:
            option = int(user_input)
            selected_group = current_list[option]

            # If selected group has children, go one tier deeper, else return the group
            if "children" in inventory.get(selected_group, {}):
                return choose_group(inventory, selected_group)
            else:
                return selected_group
        except (ValueError, IndexError):
            logger.warning("Please enter a valid index.")
            
            
def choose_host(inventory: Dict[str, Any], group_name: str) -> str:
    """Allow the user to choose a host from a specific group in the inventory."""
    hosts = sorted(inventory[group_name]["hosts"])
    all_hostvars = inventory["_meta"]["hostvars"]

    # Pre-calculate row data for faster filtering and display
    rows_data = []
    for host in hosts:
        hostvars = all_hostvars.get(host, {})
        connection_protocol = hostvars.get("connection_protocol", "ssh").upper()
        if connection_protocol == "SSM":
            target = hostvars.get("instance_id") or hostvars.get("instance_name", "N/A")
        else:
            target = hostvars.get("ansible_host", "N/A")

        rows_data.append({
            "host": host,
            "target": target,
            "user": hostvars.get("ansible_user", "N/A"),
            "cloud": hostvars.get("cloud_provider", "N/A"),
            "env": hostvars.get("environment", "N/A"),
            "conn": connection_protocol,
            "vpn": hostvars.get("vpn", "N/A"),
            "owner": hostvars.get("owner", "N/A"),
            "comments": hostvars.get("comments", "N/A"),
        })

    current_rows = rows_data

    while True:
        print("\033[H\033[J", end="")
        print(f"Choose a host from group {group_name}{' (filtered)' if len(current_rows) < len(rows_data) else ''}:")
        table = PrettyTable()
        table.field_names = [
            "Index", "Host", "Target", "User", "Cloud Provider", "Environment", "Connection", "VPN", "Owner", "Comments",
        ]
        table.align = "l"
        table.border = True

        for index, row in enumerate(current_rows):
            table.add_row([
                index, row["host"], row["target"], row["user"], row["cloud"],
                row["env"], row["conn"], row["vpn"], row["owner"], row["comments"]
            ])

        print(table)

        prompt = f"Choose a valid host index, filter with '/keyword'"
        if len(current_rows) == 1:
            prompt += " or press Enter to select the only option"
        prompt += f" or press CTRL+C to exit: "

        user_input = input(prompt).strip()

        if not user_input and len(current_rows) == 1:
            return current_rows[0]["host"]

        if user_input == '/':
            current_rows = rows_data
            continue

        if user_input.startswith('/'):
            filter_str = user_input[1:].lower()
            new_rows = [
                row for row in rows_data
                if any(filter_str in str(val).lower() for val in row.values())
            ]
            if not new_rows:
                print(f"\033[91mNo hosts found matching '{filter_str}'. Keeping current list.\033[0m")
            else:
                current_rows = new_rows
            continue

        try:
            option = int(user_input)
            return current_rows[option]["host"]
        except (ValueError, IndexError):
            logger.warning("Please enter a valid index.")


def get_host_vars(inventory: Dict[str, Any], hostname: str) -> Dict[str, Any]:
    """Retrieve the variables for a given host in the inventory."""
    all_hostvars = inventory["_meta"]["hostvars"]

    if hostname in all_hostvars:
        return all_hostvars[hostname]

    logger.warning(f"Host '{hostname}' not found in inventory.")
    selected_group = choose_group(inventory)
    return all_hostvars[choose_host(inventory, selected_group)]

def compose_ssh_cmd(hostvars: Dict[str, Any], private_key: Optional[str], enable_jump: bool = False) -> List[str]:
    """Compose the SSH command using host variables."""
    ssh_cmd = ["ssh"]

    if enable_jump and hostvars.get('vpn', False):
        ssh_cmd += ["-J", "root@vpn.mrmilu.com"]

    # User and Host part of the SSH command
    user_host = f"{hostvars.get('ansible_user', '')}@{hostvars['ansible_host']}".strip("@")
    ssh_cmd.append(user_host)

    # Explicitly handle ansible_port
    if 'ansible_port' in hostvars:
        ssh_cmd.extend(["-p", str(hostvars['ansible_port'])])

    # Handle other optional SSH variables
    for opt in OPTIONAL_SSH_VARS:
        if opt['key'] in hostvars and opt['key'] != 'ansible_port' and hostvars[opt['key']]:
            if opt['flag']:
                ssh_cmd.append(opt['flag'])
            ssh_cmd.append(str(hostvars[opt['key']]))

    # Private key if provided
    if private_key:
        ssh_cmd.extend(["-i", private_key])

    return ssh_cmd


def generate_ssh_config(inventory: Dict[str, Any], private_key: Optional[str] = None, enable_jump: bool = False) -> str:
    """
    Generate an SSH configuration based on the inventory.
    """
    all_hostvars = inventory.get("_meta", {}).get("hostvars", {})
    config_output = []

    for hostname, hostvars in sorted(all_hostvars.items()):
        # Only process hosts with SSH connection protocol
        if hostvars.get('connection_protocol', 'ssh').lower() != 'ssh':
            continue

        ansible_host = hostvars.get('ansible_host')
        if not ansible_host:
            continue

        config_output.append(f"Host {ansible_host}")
        config_output.append(f"    HostName {ansible_host}")

        if 'ansible_user' in hostvars:
            config_output.append(f"    User {hostvars['ansible_user']}")

        if 'ansible_port' in hostvars:
            config_output.append(f"    Port {hostvars['ansible_port']}")

        if hostvars.get('vpn', False):
            config_output.append("    ProxyJump root@vpn.mrmilu.com")

        config_output.append("")

    return "\n".join(config_output)


def get_instance_id_by_name(instance_name: str, aws_profile: Optional[str] = None, aws_region: Optional[str] = None) -> Optional[str]:
    """
    Get EC2 instance ID by instance name using boto3.

    Args:
        instance_name: The Name tag of the EC2 instance
        aws_profile: AWS profile to use
        aws_region: AWS region to search in

    Returns:
        str: Instance ID if found, None otherwise
    """
    if not BOTO3_AVAILABLE:
        logger.error("boto3 is not installed. Install it with: pip install boto3")
        sys.exit(1)

    try:
        # Create session with profile if specified
        session_kwargs = {}
        if aws_profile:
            session_kwargs['profile_name'] = aws_profile
        if aws_region:
            session_kwargs['region_name'] = aws_region

        session = boto3.Session(**session_kwargs)
        ec2 = session.client('ec2')

        # Search for instance by Name tag
        response = ec2.describe_instances(
            Filters=[
                {
                    'Name': 'tag:Name',
                    'Values': [instance_name]
                },
                {
                    'Name': 'instance-state-name',
                    'Values': ['running', 'stopped', 'stopping', 'pending']
                }
            ]
        )

        # Extract instance ID from response
        instances = []
        for reservation in response['Reservations']:
            for instance in reservation['Instances']:
                instances.append(instance)

        if not instances:
            logger.error(f"No EC2 instance found with Name tag '{instance_name}'")
            return None

        if len(instances) > 1:
            print(f"Multiple instances found with Name tag '{instance_name}'.")
            table = PrettyTable()
            table.field_names = ["Index", "Instance ID", "State", "Instance Type", "Private IP"]
            table.align = "l"
            table.border = True

            for idx, inst in enumerate(instances):
                state = inst['State']['Name']
                instance_type = inst.get('InstanceType', 'N/A')
                private_ip = inst.get('PrivateIpAddress', 'N/A')
                table.add_row([idx, inst['InstanceId'], state, instance_type, private_ip])

            print(table)

            while True:
                try:
                    option = int(input("Choose a valid instance index or press CTRL+C to exit: "))
                    if 0 <= option < len(instances):
                        instance_id = instances[option]['InstanceId']
                        break
                    else:
                        logger.warning(f"Please enter a valid index between 0 and {len(instances) - 1}.")
                except ValueError:
                    logger.warning("Please enter a valid number.")
                except KeyboardInterrupt:
                    print("\nOperation cancelled.")
                    sys.exit(0)
        else:
            instance_id = instances[0]['InstanceId']

        logger.info(f"✓ Found instance: {instance_name} -> {instance_id}")
        return instance_id

    except NoCredentialsError:
        logger.error("AWS credentials not found. Please configure your AWS credentials.")
        logger.error("Run: aws configure --profile <profile-name>")
        sys.exit(1)
    except ClientError as e:
        logger.error(f"AWS API error - {e}")
        sys.exit(1)
    except Exception as e:
        logger.error(f"Failed to get instance ID - {e}")
        sys.exit(1)


def compose_ssm_cmd(hostvars: Dict[str, Any]) -> List[str]:
    """Compose the AWS SSM command using host variables."""
    ssm_cmd = ["aws", "ssm", "start-session"]

    # Get instance ID - either directly provided or lookup by name
    instance_id = None

    if 'instance_id' in hostvars:
        instance_id = hostvars['instance_id']
    elif 'instance_name' in hostvars:
        # Lookup instance ID by name using boto3
        aws_profile = hostvars.get('aws_profile')
        aws_region = hostvars.get('aws_region')
        instance_id = get_instance_id_by_name(hostvars['instance_name'], aws_profile, aws_region)
        if not instance_id:
            sys.exit(1)
    else:
        logger.error("Either 'instance_id' or 'instance_name' is required for SSM connections")
        sys.exit(1)

    ssm_cmd.extend(["--target", instance_id])

    # Add AWS profile if specified
    if 'aws_profile' in hostvars:
        ssm_cmd.extend(["--profile", hostvars['aws_profile']])

    # Add AWS region if specified
    if 'aws_region' in hostvars:
        ssm_cmd.extend(["--region", hostvars['aws_region']])

    return ssm_cmd


def main() -> None:
    """Run the main program logic."""
    check_python_version()
    check_executables()

    args = parse_args()
    inventory = get_inventory(args.inventory)

    if args.generate_ssh_config:
        print(generate_ssh_config(inventory, args.key, args.enable_jump))
        sys.exit(0)

    if args.hostname:
        hostvars = get_host_vars(inventory, args.hostname)
    else:
        selected_group = choose_group(inventory)
        selected_host = choose_host(inventory, selected_group)
        hostvars = get_host_vars(inventory, selected_host)

    # Detect connection protocol (default to SSH)
    connection_protocol = hostvars.get('connection_protocol', 'ssh').lower()

    # Compose command based on connection protocol
    if connection_protocol == 'ssm':
        # Check AWS CLI is available for SSM connections
        check_executables(check_aws=True)
        connection_cmd = compose_ssm_cmd(hostvars)
        target = hostvars.get('instance_id') or hostvars.get('instance_name', 'unknown')
    else:
        # Default to SSH
        connection_cmd = compose_ssh_cmd(hostvars, args.key, args.enable_jump)
        target = hostvars.get('ansible_host', 'unknown')

    # Optional color change for Production environments
    if args.color and (hostvars.get('environment', '').lower() in ['prod', 'production']):
        background_color = args.production_background or '167'
        foreground_color = args.production_foreground or '0'
        connection_cmd = ['tput', 'setab', background_color, ';'] + ['tput', 'setaf', foreground_color, ';'] + connection_cmd + [';', 'tput', 'sgr0']

    logger.info(f"Connecting to {target} via {connection_protocol.upper()}...")
    os.execvp('bash', ['bash', '-c', ' '.join(connection_cmd)])

if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\n\nOperation cancelled by user. Exiting...")
        sys.exit(0)
